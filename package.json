{
  "name": "aitext",
  "version": "1.0.0",
  "description": "一个面向电商运营场景的 AI 内容助手项目。   目标是完成可演示、可复现、可讲技术深度的全栈 AI 应用：",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepare": "husky",
    "test:api": "npm --prefix apps/api test",
    "test:web": "npm --prefix apps/web test",
    "test:e2e:web": "npm --prefix apps/web run test:e2e",
    "build:web": "npm --prefix apps/web run build",
    "ci": "npm run test:api && npm run test:web && npm run build:web && npm run test:e2e:web",
    "test": "npm run ci"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "npm --prefix apps/api exec eslint --fix",
      "npm --prefix apps/api exec prettier --write"
    ],
    "apps/web/**/*.{ts,vue}": [
      "npm --prefix apps/web exec eslint --fix",
      "npx prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "npx prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3"
  }
}
