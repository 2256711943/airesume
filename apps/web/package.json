{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "eslint . --fix",
    "start": "nuxt start",
    "preview": "nuxt preview",
    "test": "node ./scripts/prepare-vitest.cjs && node -r ./scripts/vitest-preload.cjs ./node_modules/vitest/vitest.mjs run --configLoader runner --pool threads",
    "test:watch": "node ./scripts/prepare-vitest.cjs && node -r ./scripts/vitest-preload.cjs ./node_modules/vitest/vitest.mjs --configLoader runner --pool threads",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "nuxt": "^4.0.3",
    "ofetch": "^1.5.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1"
  }
}
