DATABASE_URL=file:./dev.db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN_SECONDS=7200
COPY_USE_MOCK=false
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TIMEOUT_MS=20000
PDF_BROWSER_MAX_CONCURRENT_SESSIONS=2
PDF_BROWSER_SESSION_ACQUIRE_TIMEOUT_MS=10000
PDF_BROWSER_LAUNCH_TIMEOUT_MS=15000
PDF_BROWSER_CLOSE_TIMEOUT_MS=5000

# Seed user (optional)
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=secret123
SEED_USER_NAME=Demo User
