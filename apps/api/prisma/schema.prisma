generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  passwordHash String      @map("password_hash")
  name        String
  resumeTasks ResumeTask[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model ResumeTask {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  status       TaskStatus
  requestId    String          @unique @map("request_id")
  modelName    String          @map("model_name")
  errorCode    String?         @map("error_code")
  errorMessage String?         @map("error_message")
  startedAt    DateTime?       @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_tasks")
}

model ResumeVersion {
  id         String            @id @default(cuid())
  taskId     String            @map("task_id")
  variantIdx Int               @map("variant_index")
  summary    String
  experience Json
  projects   Json
  skills     Json
  sourceType ResumeSourceType  @map("source_type")
  task       ResumeTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([taskId, variantIdx])
  @@map("resume_versions")
}

enum TaskStatus {
  pending
  running
  succeeded
  failed
}

enum ResumeSourceType {
  generated
  optimized
}

