generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     String                        @id @default(cuid())
  email                  String                        @unique
  passwordHash           String                        @map("password_hash")
  name                   String
  conversations          Conversation[]
  resumeTasks            ResumeTask[]
  resumeLibraryItems     ResumeLibraryItem[]
  variantSelectionEvents ResumeVariantSelectionEvent[]
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  @@map("users")
}

model ResumeTask {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  status       TaskStatus
  requestId    String          @unique @map("request_id")
  modelName    String          @map("model_name")
  errorCode    String?         @map("error_code")
  errorMessage String?         @map("error_message")
  startedAt    DateTime?       @map("started_at")
  finishedAt   DateTime?       @map("finished_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_tasks")
}

model ResumeVersion {
  id         String            @id @default(cuid())
  taskId     String            @map("task_id")
  variantIdx Int               @map("variant_index")
  summary    String
  experience Json
  projects   Json
  skills     Json
  sourceType ResumeSourceType  @map("source_type")
  task       ResumeTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([taskId, variantIdx])
  @@map("resume_versions")
}

enum TaskStatus {
  pending
  running
  succeeded
  failed
}

enum ResumeSourceType {
  generated
  optimized
}

model ResumeLibraryItem {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  title           String
  summary         String
  experience      Json
  projects        Json
  skills          Json
  sourceRequestId String?           @map("source_request_id")
  sourceMode      ResumeRewriteMode @map("source_mode")
  metadata        Json?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_library_items")
}

model ResumeVariantSelectionEvent {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")
  requestId       String            @map("request_id")
  mode            ResumeRewriteMode
  addToLibrary    Boolean           @map("add_to_library")
  promptVersion   String            @map("prompt_version")
  variantSnapshot Json              @map("variant_snapshot")
  scoreSnapshot   Json?             @map("score_snapshot")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("resume_variant_selection_events")
}

enum ResumeRewriteMode {
  technical
  business
  hybrid
}

model Conversation {
  id          String                   @id @default(cuid())
  userId      String                   @map("user_id")
  title       String
  status      ConversationStatus
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]
  memorySlots ConversationMemorySlot[]
  memories    ConversationMemory[]
  contextPacks ConversationContextPack[]
  observabilityEvents ObservabilityEventLog[]
  agentRuns   AgentRun[]
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id              String                  @id @default(cuid())
  conversationId  String                  @map("conversation_id")
  role            ConversationMessageRole
  content         String
  intent          String?                 @map("intent")
  agentName       String?                 @map("agent_name")
  toolCallSummary Json?                   @map("tool_call_summary")
  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRuns       AgentRun[]
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("conversation_messages")
}

model ConversationMemorySlot {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  slotKey        String       @map("slot_key")
  slotValue      Json         @map("slot_value")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([conversationId, slotKey])
  @@index([conversationId, updatedAt(sort: Desc)])
  @@map("conversation_memory_slots")
}

model ConversationMemory {
  id             String                             @id @default(cuid())
  conversationId String                             @map("conversation_id")
  runId          String?                            @map("run_id")
  layer          ConversationMemoryLayer
  scope          ConversationMemoryScope
  content        String
  summary        String?
  tokenEstimate  Int                                @default(0) @map("token_estimate")
  priority       Int                                @default(0)
  pinned         Boolean                            @default(false)
  freshnessScore Float                              @default(0) @map("freshness_score")
  relevanceScore Float                              @default(0) @map("relevance_score")
  sourceRefs     Json                               @map("source_refs")
  mergeGroup     String?                            @map("merge_group")
  mergeStrategy  ConversationMemoryMergeStrategy?   @map("merge_strategy")
  version        Int                                @default(1)
  metadata       Json?
  expiresAt      DateTime?                          @map("expires_at")
  lastAccessedAt DateTime?                          @map("last_accessed_at")
  accessCount    Int                                @default(0) @map("access_count")
  conversation   Conversation                       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                           @default(now()) @map("created_at")
  updatedAt      DateTime                           @updatedAt @map("updated_at")

  @@index([conversationId, layer, updatedAt(sort: Desc)])
  @@index([conversationId, priority(sort: Desc)])
  @@index([conversationId, expiresAt])
  @@index([conversationId, mergeGroup])
  @@map("conversation_memories")
}

model ConversationContextPack {
  id                String        @id @map("id")
  conversationId    String        @map("conversation_id")
  runId             String?       @map("run_id")
  intent            String?
  maxTokens         Int           @map("max_tokens")
  layerOrder        Json          @map("layer_order")
  selectedMemoryIds Json          @map("selected_memory_ids")
  droppedMemoryIds  Json          @map("dropped_memory_ids")
  droppedMemories   Json          @map("dropped_memories")
  summaryBlocks     Json          @map("summary_blocks")
  finalPromptPreview String       @map("final_prompt_preview")
  usage             Json
  metadata          Json?
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  generatedAt       DateTime      @default(now()) @map("generated_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([conversationId, generatedAt(sort: Desc)])
  @@index([conversationId, runId, generatedAt(sort: Desc)])
  @@index([conversationId, intent, generatedAt(sort: Desc)])
  @@map("conversation_context_packs")
}

model AgentRun {
  id                   String          @id @default(cuid())
  conversationId       String          @map("conversation_id")
  messageId            String          @map("message_id")
  orchestratorDecision Json?           @map("orchestrator_decision")
  selectedAgent        String?         @map("selected_agent")
  status               AgentRunStatus
  errorCode            String?         @map("error_code")
  latencyMs            Int?            @map("latency_ms")
  conversation         Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message              ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  toolCallLogs         ToolCallLog[]
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("agent_runs")
}

model ToolCallLog {
  id         String       @id @default(cuid())
  agentRunId String       @map("agent_run_id")
  toolName   String       @map("tool_name")
  inputJson  Json         @map("input_json")
  outputJson Json?        @map("output_json")
  success    Boolean
  latencyMs  Int?         @map("latency_ms")
  agentRun   AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([agentRunId, createdAt(sort: Desc)])
  @@index([toolName, createdAt(sort: Desc)])
  @@map("tool_call_logs")
}

model ObservabilityEventLog {
  id             String                       @id @map("id")
  runId          String                       @map("run_id")
  conversationId String?                      @map("conversation_id")
  userId         String?                      @map("user_id")
  agentRunId     String?                      @map("agent_run_id")
  spanId         String?                      @map("span_id")
  seq            Int
  type           String
  status         ObservabilityEventLogStatus? @map("status")
  ts             DateTime                     @map("ts")
  payload        Json
  conversation   Conversation?                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                     @default(now()) @map("created_at")

  @@unique([runId, seq])
  @@index([runId, seq])
  @@index([conversationId, ts(sort: Desc)])
  @@index([agentRunId, seq])
  @@index([type, ts(sort: Desc)])
  @@map("observability_events")
}

enum ConversationStatus {
  active
  archived
}

enum ConversationMemoryLayer {
  session
  resume
  preference
  tool_result
  system
}

enum ConversationMemoryScope {
  conversation
  user
  global
}

enum ConversationMemoryMergeStrategy {
  replace
  append
  summarize
}

enum ConversationMessageRole {
  user
  assistant
  system
  tool
}

enum AgentRunStatus {
  running
  succeeded
  failed
  timeout
  canceled
  partial_success
}

enum ObservabilityEventLogStatus {
  normal
  replay
  suppressed
}
